# PenLight – Huelle fuer installiertes TTaroModUtils.
# ModForge haengt diese Wurzel nur ein, wenn TTaroModUtils installiert ist
# (ForgeBlueprints/PenLightContainer.xml, <requires mods="TTaroModUtils"/>), sonst
# PenLightRoot aus PenLight.unbound. Diese Datei nutzt die veroeffentlichten Makros und
# Elemente von TTaroModUtils (TT_GET_PREF, TT_DRAGGABLE_POSITION, TT_DRAGGABLE,
# TT_ConfigButtonElement) und gibt die Einstellungen als _ext an PenLightRoot weiter.
# Optionsseite: ModSchemas/diedreibeiden-penlight.schema.json, Texte texts/<sprache>/penlight.mo.

# TTaroModUtils-Schluessel = author + '.' + key aus dem Schema
(def constant PENLIGHT_PREF_POSITION 'diedreibeiden.penlight.position')
(def constant PENLIGHT_PREF_LOCK 'diedreibeiden.penlight.disableDragDrop')
(def constant PENLIGHT_PREF_SCALE 'diedreibeiden.penlight.scale')
(def constant PENLIGHT_PREF_COLOR_MODE 'diedreibeiden.penlight.colorMode')
(def constant PENLIGHT_PREF_DETAIL_MODE 'diedreibeiden.penlight.detailMode')
# Seite in TTaro Mod Config = author + '.' + slug aus dem Schema (fuer das eigene Zahnrad)
(def constant PENLIGHT_MOD_SLUG 'diedreibeiden.penlight')

(def element PenLightTTaroRoot() layout=true
	(scope
		(macro STAGE_SIZE)

		# Position: gespeicherte Drag-Position (Bildschirmkoordinaten) oder Rueckfall
		(macro TT_GET_PREF _varName="'lockPref'" _key="PENLIGHT_PREF_LOCK")
		(var isPositionLocked:bool = "null != lockPref && null != lockPref.value ? lockPref.value : false")
		(macro TT_DRAGGABLE_POSITION _fullKey="PENLIGHT_PREF_POSITION")
		(var hasDragPosition:bool = "null != __dragPos && null != __dragPos.value && isNumber(__dragPos.value.x)")
		(var posX:number = "hasDragPosition ? dragX : stageWidth / 2 + PENLIGHT_SETTINGS.offsetX")
		(var posY:number = "hasDragPosition ? dragY : stageHeight / 2 + PENLIGHT_SETTINGS.offsetY")

		# Optionen aus TTaro Mod Config
		(macro TT_GET_PREF _varName="'scalePref'" _key="PENLIGHT_PREF_SCALE")
		(var uiScale:number = "null != scalePref && null != scalePref.value ? scalePref.value : 1")
		(macro TT_GET_PREF _varName="'colorModePref'" _key="PENLIGHT_PREF_COLOR_MODE")
		(var colorMode:number = "null != colorModePref && null != colorModePref.value ? colorModePref.value : 0")
		(macro TT_GET_PREF _varName="'detailModePref'" _key="PENLIGHT_PREF_DETAIL_MODE")
		(var detailMode:number = "null != detailModePref && null != detailModePref.value ? detailModePref.value : 0")

		(var ext:dict = "{posX: posX, posY: posY, scale: uiScale, colorMode: colorMode, detailMode: detailMode}")

		# Zahnrad und Greifflaeche nur, solange man lebt (wie die Anzeige selbst)
		(var avatar:gfx = "$datahub.getSingleEntity(CC.playerAvatar)")
		(var healthComponent:gfx = "avatar ? avatar.health : null")
		(var isAlive:bool = "healthComponent ? healthComponent.isAlive : false" (event "healthComponent.evIsAliveChanged"))
	)

	(style
		(position = "absolute")
		(bind width "stageWidth")
		(bind height "stageHeight")
	)

	(element PenLightRoot _ext="ext"
		(style (position = "absolute") (left = 0) (top = 0))
	)

	(block
		(bind visible "isAlive")
		(style
			(position = "absolute")
			(bind left "posX")
			(bind top "posY")
			(bind scaleX "uiScale")
			(bind scaleY "uiScale")
		)
		# eigenes Zahnrad links neben der Anzeige, sichtbar bei aktivem Mauszeiger (Strg);
		# oeffnet TTaro Mod Config direkt auf der PenLight-Seite (wie BuildViewer)
		(element TT_ConfigButtonElement _modSlug="PENLIGHT_MOD_SLUG" _tooltipAlign="outerTop|outerLeft"
			(style
				(left = -30px)
				(top = 0px)
			)
		)
		# Greifflaeche ueber Granate | Schild mit Rand (dragPad*), damit sie leicht zu treffen ist
		(block
			(style
				(position = "absolute")
				(bind left "0 - PENLIGHT_SETTINGS.dragPadLeft")
				(bind top "0 - PENLIGHT_SETTINGS.dragPadTop")
				(bind width "PENLIGHT_SETTINGS.iconSize * 2 + PENLIGHT_SETTINGS.iconGap + PENLIGHT_SETTINGS.dragPadLeft + PENLIGHT_SETTINGS.dragPadRight")
				(bind height "PENLIGHT_SETTINGS.iconSize + PENLIGHT_SETTINGS.dragPadTop + PENLIGHT_SETTINGS.dragPadBottom")
				(backgroundColor = 0x00FFFFFF)
				(bind hitTest "!isPositionLocked")
			)
			(macro TT_DRAGGABLE _fullKey="PENLIGHT_PREF_POSITION" _isDragEnabled="!isPositionLocked")
		)
	)
)
