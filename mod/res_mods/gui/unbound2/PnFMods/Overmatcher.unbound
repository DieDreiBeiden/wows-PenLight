# Overmatcher – Anzeige am Fadenkreuz fuer das aufgeschaltete Ziel.
# Daten: CC.mods_DataComponent 'modOvermatcher' aus Main.py
#   {byId: {'<avatarId>': [attack, defense, detail, attackImage, defenseImage]}, byName: {...}}
#   attackImage/defenseImage = Detail-Bild ohne .png (detail_<bugheck>_<mitte>_<deck>), '' = keine Daten
# Layout: zwei Spalten rechts neben dem Fadenkreuz, Granate | Schild; mit Alt erscheint
# unter jedem Symbol das Detail-Schiff.
# Muster: Einbindung wie PenetrationCalculator (TTaro), Zielerkennung wie
# XTargetTracker (Battle Expert, AutoSpy).
# Icons: res_mods/PnFMods/Overmatcher/{shell,shield}_{green,yellow,red}.png, 19x19 wie PenCalc.
# Position: kommt aus Main.py (omData.position, relativ zur Bildschirmmitte), einstellbar im
# Gefecht mit Strg+Alt+Pfeiltasten. Keine Abhaengigkeit ausser ModForge (Einbindung).

# Einstellungen
(def constant OVERMATCHER_SETTINGS {
	# Rueckfall-Position, falls Main.py (noch) keine liefert: Abstand zur Bildschirmmitte in px
	offsetX: 30,
	offsetY: 8,
	# Abstand zwischen den Spalten Granate | Schild
	gap: 6,
	# Abstand zwischen Symbol und Detail-Schiff (Alt)
	detailGap: 3
})

(def constant OVERMATCHER_COMPONENT_KEY 'modOvermatcher')

# Pfad relativ zu gui/unbound2/PnFMods/ (wie PenetrationCalculator)
(def constant OVERMATCHER_ICON_PATH 'url:../../../PnFMods/Overmatcher/')

(def element OvermatcherRoot() layout=true
	(scope
		(var stageComponent:gfx = "$datahub.getSingleComponent(CC.stage)")
		(var stageWidth:number = "stageComponent.width" (event "stageComponent.evStageSizeChanged"))
		(var stageHeight:number = "stageComponent.height" (event "stageComponent.evStageSizeChanged"))

		(var cameraEntity:gfx = "$datahub.getSingleEntity(CC.camera)")
		(var cameraMode:number = "cameraEntity.camera.mode" (event "cameraEntity.camera.evModeChanged"))
		(var isCameraTrackingShell:bool = "cameraMode == CameraMode.SHELLTRACKER")
		(var isTactical:bool = "cameraEntity.camera.isTactical" (event "cameraEntity.camera.evTacticalStateChanged"))

		(var avatar:gfx = "$datahub.getSingleEntity(CC.playerAvatar)")
		(var healthComponent:gfx = "avatar ? avatar.health : null")
		(var isAlive:bool = "healthComponent ? healthComponent.isAlive : false" (event "healthComponent.evIsAliveChanged"))

		(var isCrosshairVisible:bool = "isAlive && !isCameraTrackingShell && !isTactical")
	)

	(style
		(position = "absolute")
		(bind width "stageWidth")
		(bind height "stageHeight")
		(hitTest = false)
	)

	(controller $Instance renderer='OvermatcherCrosshairItem'
		(bind enabled "isAlive")
		(exprs
			(style (position = "absolute") (left = 0) (top = 0))
			(bind visible "isCrosshairVisible")
		)
	)
)

(def element OvermatcherCrosshairItem() layout=true
	(scope
		(macro STAGE_SIZE)

		# Zielerkennung: jeder Avatar meldet per evTargetChanged, ob er aufgeschaltet ist
		(event evTargetChanged)
		(var enemies:gfx = "$datahub.getCollection(CC.avatar)")
		(var currentTarget:gfx = "$event.entity" watch=false init=false (event "evTargetChanged"))
		(var targetAvatar:gfx = "currentTarget && currentTarget.hasComponent(CC.avatar) ? currentTarget.avatar : null" (event "evTargetChanged"))
		(var targetKey:str = "targetAvatar ? toString(targetAvatar.id) : ''" (event "evTargetChanged"))
		(var targetName:str = "targetAvatar ? targetAvatar.name : ''" (event "evTargetChanged"))

		# Daten aus Main.py
		(var omWatcher:gfx = "$datahub.getPrimWatcher(CC.mods_DataComponent, OVERMATCHER_COMPONENT_KEY)")
		(var omEntity:gfx = "omWatcher.entity" (event "omWatcher.event"))
		(var omComponent:gfx = "omEntity ? omEntity.mods_DataComponent : null")
		(var omData:dict = "omComponent ? omComponent.data : {}" (event "omComponent.evDataChanged"))
		(var byId:dict = "'byId' in omData && null != omData.byId ? omData.byId : {}")
		(var byName:dict = "'byName' in omData && null != omData.byName ? omData.byName : {}")

		# Position relativ zur Bildschirmmitte, von Main.py (Strg+Alt+Pfeiltasten)
		(var position:dict = "'position' in omData && null != omData.position ? omData.position : {}")
		(var offsetX:number = "'x' in position && isNumber(position.x) ? position.x : OVERMATCHER_SETTINGS.offsetX")
		(var offsetY:number = "'y' in position && isNumber(position.y) ? position.y : OVERMATCHER_SETTINGS.offsetY")
		(var posX:number = "stageWidth / 2 + offsetX")
		(var posY:number = "stageHeight / 2 + offsetY")

		(var verdict:array = "(targetKey != '' && targetKey in byId) ? byId[targetKey]
								: ((targetName != '' && targetName in byName) ? byName[targetName] : [])")
		(var hasVerdict:bool = "verdict.length >= 2")
		(var attackDetail:str = "verdict.length >= 5 && verdict[3] != '' ? OVERMATCHER_ICON_PATH + verdict[3] + '.png' : ''")
		(var defenseDetail:str = "verdict.length >= 5 && verdict[4] != '' ? OVERMATCHER_ICON_PATH + verdict[4] + '.png' : ''")

		# Detailansicht solange Alt gedrueckt ist (wie PenetrationCalculator)
		(var cameraEntity:gfx = "$datahub.getSingleEntity(CC.camera)")
		(var altVision:bool = "cameraEntity.camera.altVision" (event "cameraEntity.camera.evAltVisionChanged"))
		(var attackIcon:str = "hasVerdict ? OVERMATCHER_ICON_PATH + 'shell_' + verdict[0] + '.png' : ''")
		(var defenseIcon:str = "hasVerdict ? OVERMATCHER_ICON_PATH + 'shield_' + verdict[1] + '.png' : ''")
	)

	(controller $Repeat renderer='OvermatcherTargetTracker'
		(bind count "enemies.items.length" (event "enemies.evAdded") (event "enemies.evRemoved"))
		(exprs
			(scope
				(bind _currentTargetId "currentTarget ? currentTarget.id : 0")
			)
		)
	)

	(hblock
		(bind visible "hasVerdict")
		(style
			(position = "absolute")
			(bind left "posX")
			(bind top "posY")
		)
		(element OvermatcherColumn _icon="attackIcon" _ship="attackDetail" _showDetail="altVision")
		(element OvermatcherColumn _icon="defenseIcon" _ship="defenseDetail" _showDetail="altVision")
	)
)

# Spalte: Ampel-Symbol (19x19), darunter bei Alt das ganze Schiff (50x30) in der
# Farbkombination. Farbe immer "gut fuer mich" (Python waehlt das Bild).
# Feste Breite 50, damit die Symbole beim Druecken von Alt nicht verrutschen.
(def element OvermatcherColumn(_icon:str, _ship:str, _showDetail:bool) layout=true
	(style
		(width = 50)
		(bind marginRight "OVERMATCHER_SETTINGS.gap")
	)
	(element OvermatcherIcon _url="_icon")
	(block
		(bind visible "_showDetail && _ship != ''")
		(style
			(bind marginTop "OVERMATCHER_SETTINGS.detailGap")
			(bind backgroundImage "_ship")
			(width = 50) (height = 30)
			(backgroundSize = "fill")
		)
	)
)

(def element OvermatcherIcon(_url:str) layout=true
	(style
		(bind backgroundImage "_url")
		(width = 19) (height = 19)
		(backgroundSize = "fill")
	)
)

# Kopie von XTargetTracker unter eigenem Namen (ModForge meldet doppelte Namen als Konflikt)
(def element OvermatcherTargetTracker() layout=false
	(scope
		(var _currentTargetId:number = 0)
		(var avatars:gfx = "$datahub.getCollection(CC.avatar)")
		(var trackedEntity:gfx = "avatars.items[$index]" watch=false)
		(var targetComponent:gfx = "trackedEntity.hasComponent(CC.target) ? trackedEntity.target : null"
			(event "trackedEntity.evAdded")
			(event "trackedEntity.evRemoved")
		)
		(var targetFlags:number = "targetComponent ? targetComponent.flags : 0"
			(event "targetComponent.evFlagsChanged")
		)
		(var isTargetLocked:bool = "(targetFlags & LOCKABLE_WEAPONS) > 0")
	)
	(dispatch evTargetChanged args="{entity: isTargetLocked ? trackedEntity : null}" dir="EventDirection.UP"
		(bind enabled "isTargetLocked || _currentTargetId == trackedEntity.id")
		(event "targetComponent.evFlagsChanged")
	)
	(dispatch evTargetChanged args="{entity: trackedEntity}" dir="EventDirection.UP" on='addedToStage'
		(bind enabled "isTargetLocked")
	)
)

(def css $OvermatcherText()
	(extends $TextDefaultBoldNM)
	(extends $FontEnableReadability)
)
