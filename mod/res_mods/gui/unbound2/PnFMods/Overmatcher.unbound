# Overmatcher – Anzeige am Fadenkreuz fuer das aufgeschaltete Ziel.
# Daten: CC.mods_DataComponent 'modOvermatcher' aus Main.py
#   {byId: {'<avatarId>': [attack, defense, detail, attackImage, defenseImage]}, byName: {...}}
#   attackImage/defenseImage = Detail-Bild ohne .png (detail_<target|me>_<bugheck>_<mitte>_<deck>),
#   '' = keine Daten. Beschriftung "ME"/"TARGET" samt Mini-Icon ist Teil des Bildes.
# Layout rechts neben dem Fadenkreuz: Granate | Schild kompakt nebeneinander, immer sichtbar
# (solange das Fadenkreuz sichtbar ist). Ampelfarben nur mit aufgeschaltetem, bewertetem Ziel,
# sonst grau (kein Ziel, Zerstoerer/Flugzeugtraeger/U-Boot, keine Daten).
# Solange Alt gedrueckt ist und eine Bewertung vorliegt, ersetzen die beschrifteten Detail-Schiffe die Symbole:
# untereinander oben "TARGET" (Ziel, ich -> Ziel) und darunter "ME" (eigenes Schiff, Ziel -> ich),
# linke obere Ecke an der Stelle der Symbole.
# Muster: Einbindung wie PenetrationCalculator (TTaro), Zielerkennung wie
# XTargetTracker (Battle Expert, AutoSpy).
# Alt-Ansicht (Prototyp): Spiel-Silhouetten img://gui/ship_bars/<shortName>_h.png in vier Sektionen
# (Aufbauten = Deck, Rumpf = Heck/Mitte/Bug); Rueckfall auf detail_*.png (useSilhouettes in OVERMATCHER_SETTINGS).
# Icons: res_mods/PnFMods/Overmatcher/{shell,shield}_{green,yellow,red,grey}.png, 29x29 (gezeichnet von tools/make_ampel_icons.py).
# Position: per Ziehen ueber TTaroModUtils (Schema ModSchemas/diedreibeiden-overmatcher.schema.json,
# Muster wie BuildViewer). Benoetigt TTaroModUtils (Makros TT_DRAGGABLE_POSITION/TT_DRAGGABLE/TT_GET_PREF).
# Ohne gespeicherte Position gelten offsetX/offsetY relativ zur Bildschirmmitte.

# Einstellungen
(def constant OVERMATCHER_SETTINGS {
	# Rueckfall-Position (linke obere Ecke der Anzeige), solange TTaroModUtils keine liefert:
	# Abstand zur Bildschirmmitte in Pixeln (x: + = rechts, y: + = unten). x >= 30 haelt die
	# Detail-Schiffe (Alt) von der senkrechten Fadenkreuzlinie fern.
	offsetX: 30,
	offsetY: 8,
	# Abstand zwischen Granate und Schild
	iconGap: 4,
	# Groesse von Granate/Schild (Icons werden so erzeugt, tools/make_ampel_icons.py)
	iconSize: 29,
	# senkrechter Abstand zwischen den beiden Detail-Schiffen (Alt, Target oben, Me unten)
	shipGap: 6,
	# Groesse der Detail-Schiffe (Bilder werden in dieser Groesse erzeugt, tools/make_detail_icons.py)
	detailWidth: 125,
	detailHeight: 75,
	# Alt-Ansicht mit den Spiel-Silhouetten (img://gui/ship_bars/<shortName>_h.png, wie der
	# Lebensbalken unten links). false = gezeichnete Detail-Bilder (detail_*.png).
	# Ohne Silhouetten-Name (Ziel oder eigenes Schiff unbekannt) gelten ebenfalls die Bilder.
	useSilhouettes: true,
	# Bildflaeche wie im Spiel-Lebensbalken (BAR_IMAGE_WIDTH/HEIGHT in own_ship_health.unbound)
	silhouetteWidth: 186,
	silhouetteHeight: 48,
	# Sektionsgrenzen als Anteil der Silhouettenbreite (Naeherung, gleich fuer alle Schiffe):
	# Heck 0..sternEnd, Mitte sternEnd..bowStart, Bug bowStart..1. Bug und Heck haben dieselbe
	# Farbe, die Blickrichtung der Silhouette spielt daher keine Rolle.
	sternEnd: 0.22,
	bowStart: 0.78,
	# Decklinie als Anteil der Bildhoehe von oben: darueber (Aufbauten) = Deck, darunter
	# (Rumpf) = Heck/Mitte/Bug. Gemessen an Rhode Island, Vermont, Trento im Spiel (Rumpf =
	# unterste ~28 % des 48 px hohen Bildes); bei einzelnen Schiffen +-1-2 px moeglich.
	deckLine: 0.71,
	# dunkle Fuge zwischen den Sektionen (Anteil der Breite bzw. Hoehe)
	zoneGap: 0.01,
	zoneGapY: 0.03,
	# Beschriftung (label_*.png, tools/make_detail_icons.py): Mini-Icon + Text mittig, Breite = silhouetteWidth
	labelWidth: 186,
	labelHeight: 24,
	# die Bilder haben oben freien Raum; Beschriftung so weit in die Bildflaeche ziehen
	labelOverlap: 8,
	# Abstand Silhouette -> Schiffsname
	nameGap: 3,
	# Abstand Schiffsname -> untere Rahmenlinie
	nameBottom: 4,
	# Kopfzeile unter der Rahmen-Haarlinie: Deckkraft der Trennlinie
	headLineAlpha: 0.55
})

# Einfaerbung der Silhouetten: Multiplikator 0 + Offset = Vollfarbe, Alpha bleibt (Form der Silhouette).
# Farben wie tools/make_ampel_icons.py (gruen #3DDC5A, rot, grau) bzw. dunkle Fuge.
(def constant OVERMATCHER_CT {
	green: { redMultiplier:0,greenMultiplier:0,blueMultiplier:0,alphaMultiplier:1,redOffset:61,greenOffset:220,blueOffset:90,alphaOffset:0 },
	red:   { redMultiplier:0,greenMultiplier:0,blueMultiplier:0,alphaMultiplier:1,redOffset:232,greenOffset:72,blueOffset:52,alphaOffset:0 },
	grey:  { redMultiplier:0,greenMultiplier:0,blueMultiplier:0,alphaMultiplier:1,redOffset:128,greenOffset:132,blueOffset:136,alphaOffset:0 },
	base:  { redMultiplier:0,greenMultiplier:0,blueMultiplier:0,alphaMultiplier:1,redOffset:40,greenOffset:42,blueOffset:44,alphaOffset:0 }
})
# Farbenblind-Schema (AMPEL_CB in tools/make_ampel_icons.py): blau = Overmatch, orange = kein Overmatch
(def constant OVERMATCHER_CT_CB {
	green: { redMultiplier:0,greenMultiplier:0,blueMultiplier:0,alphaMultiplier:1,redOffset:43,greenOffset:140,blueOffset:232,alphaOffset:0 },
	red:   { redMultiplier:0,greenMultiplier:0,blueMultiplier:0,alphaMultiplier:1,redOffset:213,greenOffset:94,blueOffset:0,alphaOffset:0 },
	grey:  { redMultiplier:0,greenMultiplier:0,blueMultiplier:0,alphaMultiplier:1,redOffset:128,greenOffset:132,blueOffset:136,alphaOffset:0 },
	base:  { redMultiplier:0,greenMultiplier:0,blueMultiplier:0,alphaMultiplier:1,redOffset:40,greenOffset:42,blueOffset:44,alphaOffset:0 }
})

(def constant OVERMATCHER_COMPONENT_KEY 'modOvermatcher')

# Kontur + weicher Schatten der Silhouette wie bei Granate/Schild (Filter wie Spiel-Markierungen)
(def css $OvermatcherSilhouetteFX ()
	(filters
		(dropShadow
			(distance = 0)
			(angle = 90)
			(color = 0x0C0E10)
			(alpha = 0.9)
			(blurX = 2.0)
			(blurY = 2.0)
			(strength = 6.0)
			(quality = 2)
		)
		(dropShadow
			(distance = 1)
			(angle = 90)
			(color = 0x000000)
			(alpha = 0.6)
			(blurX = 6.0)
			(blurY = 6.0)
			(strength = 1.0)
			(quality = 2)
		)
	)
)

# TTaroModUtils-Schluessel = author + '.' + key aus dem Schema
(def constant OVERMATCHER_PREF_POSITION 'diedreibeiden.overmatcher.position')
(def constant OVERMATCHER_PREF_LOCK 'diedreibeiden.overmatcher.disableDragDrop')
(def constant OVERMATCHER_PREF_SCALE 'diedreibeiden.overmatcher.scale')
(def constant OVERMATCHER_PREF_COLOR_MODE 'diedreibeiden.overmatcher.colorMode')
(def constant OVERMATCHER_PREF_DETAIL_MODE 'diedreibeiden.overmatcher.detailMode')
# Seite in TTaro Mod Config = author + '.' + slug aus dem Schema (fuer das eigene Zahnrad)
(def constant OVERMATCHER_MOD_SLUG 'diedreibeiden.overmatcher')

# Pfad relativ zu gui/unbound2/PnFMods/ (wie PenetrationCalculator)
(def constant OVERMATCHER_ICON_PATH 'url:../../../PnFMods/Overmatcher/')

(def element OvermatcherRoot() layout=true
	(scope
		(var stageComponent:gfx = "$datahub.getSingleComponent(CC.stage)")
		(var stageWidth:number = "stageComponent.width" (event "stageComponent.evStageSizeChanged"))
		(var stageHeight:number = "stageComponent.height" (event "stageComponent.evStageSizeChanged"))

		(var cameraEntity:gfx = "$datahub.getSingleEntity(CC.camera)")
		(var cameraMode:number = "cameraEntity.camera.mode" (event "cameraEntity.camera.evModeChanged"))
		(var isCameraTrackingShell:bool = "cameraMode == CameraMode.SHELLTRACKER")
		(var isTactical:bool = "cameraEntity.camera.isTactical" (event "cameraEntity.camera.evTacticalStateChanged"))

		(var avatar:gfx = "$datahub.getSingleEntity(CC.playerAvatar)")
		(var healthComponent:gfx = "avatar ? avatar.health : null")
		(var isAlive:bool = "healthComponent ? healthComponent.isAlive : false" (event "healthComponent.evIsAliveChanged"))

		(var isCrosshairVisible:bool = "isAlive && !isCameraTrackingShell && !isTactical")
	)

	(style
		(position = "absolute")
		(bind width "stageWidth")
		(bind height "stageHeight")
	)

	(controller $Instance renderer='OvermatcherCrosshairItem'
		(bind enabled "isAlive")
		(exprs
			(style (position = "absolute") (left = 0) (top = 0))
			(bind visible "isCrosshairVisible")
		)
	)
)

(def element OvermatcherCrosshairItem() layout=true
	(scope
		# Position: gespeicherte Drag-Position (Bildschirmkoordinaten) oder Rueckfall
		(macro STAGE_SIZE)
		(macro TT_GET_PREF _varName="'lockPref'" _key="OVERMATCHER_PREF_LOCK")
		(var isPositionLocked:bool = "null != lockPref && null != lockPref.value ? lockPref.value : false")
		(macro TT_DRAGGABLE_POSITION _fullKey="OVERMATCHER_PREF_POSITION")
		(var hasDragPosition:bool = "null != __dragPos && null != __dragPos.value && isNumber(__dragPos.value.x)")
		(var posX:number = "hasDragPosition ? dragX : stageWidth / 2 + OVERMATCHER_SETTINGS.offsetX")
		(var posY:number = "hasDragPosition ? dragY : stageHeight / 2 + OVERMATCHER_SETTINGS.offsetY")

		# Optionen aus TTaro Mod Config (Schema ModSchemas/diedreibeiden-overmatcher.schema.json)
		(macro TT_GET_PREF _varName="'scalePref'" _key="OVERMATCHER_PREF_SCALE")
		(var uiScale:number = "null != scalePref && null != scalePref.value ? scalePref.value : 1")
		(macro TT_GET_PREF _varName="'colorModePref'" _key="OVERMATCHER_PREF_COLOR_MODE")
		(var isColorBlind:bool = "null != colorModePref && null != colorModePref.value ? colorModePref.value == 1 : false")
		(macro TT_GET_PREF _varName="'detailModePref'" _key="OVERMATCHER_PREF_DETAIL_MODE")
		(var isDetailAlways:bool = "null != detailModePref && null != detailModePref.value ? detailModePref.value == 1 : false")
		# Farbschema: Dateipraefix der Icons und Einfaerbung der Silhouetten
		(var palettePrefix:str = "isColorBlind ? 'cb_' : ''")
		(var palette:dict = "isColorBlind ? OVERMATCHER_CT_CB : OVERMATCHER_CT")

		# Zielerkennung: jeder Avatar meldet per evTargetChanged, ob er aufgeschaltet ist
		(event evTargetChanged)
		(var enemies:gfx = "$datahub.getCollection(CC.avatar)")
		(var currentTarget:gfx = "$event.entity" watch=false init=false (event "evTargetChanged"))
		(var targetAvatar:gfx = "currentTarget && currentTarget.hasComponent(CC.avatar) ? currentTarget.avatar : null" (event "evTargetChanged"))
		(var targetKey:str = "targetAvatar ? toString(targetAvatar.id) : ''" (event "evTargetChanged"))
		(var targetName:str = "targetAvatar ? targetAvatar.name : ''" (event "evTargetChanged"))

		# Daten aus Main.py
		(var omWatcher:gfx = "$datahub.getPrimWatcher(CC.mods_DataComponent, OVERMATCHER_COMPONENT_KEY)")
		(var omEntity:gfx = "omWatcher.entity" (event "omWatcher.event"))
		(var omComponent:gfx = "omEntity ? omEntity.mods_DataComponent : null")
		(var omData:dict = "omComponent ? omComponent.data : {}" (event "omComponent.evDataChanged"))
		(var byId:dict = "'byId' in omData && null != omData.byId ? omData.byId : {}")
		(var byName:dict = "'byName' in omData && null != omData.byName ? omData.byName : {}")

		(var verdict:array = "(targetKey != '' && targetKey in byId) ? byId[targetKey]
								: ((targetName != '' && targetName in byName) ? byName[targetName] : [])")
		(var hasVerdict:bool = "verdict.length >= 2")
		(var attackDetail:str = "verdict.length >= 5 && verdict[3] != '' ? OVERMATCHER_ICON_PATH + verdict[3] + '.png' : ''")
		(var defenseDetail:str = "verdict.length >= 5 && verdict[4] != '' ? OVERMATCHER_ICON_PATH + verdict[4] + '.png' : ''")

		# Detailansicht solange Alt gedrueckt ist (wie PenetrationCalculator)
		(var cameraEntity:gfx = "$datahub.getSingleEntity(CC.camera)")
		(var altVision:bool = "cameraEntity.camera.altVision" (event "cameraEntity.camera.evAltVisionChanged"))
		(var attackIcon:str = "OVERMATCHER_ICON_PATH + 'shell_' + palettePrefix + (hasVerdict ? verdict[0] : 'grey') + '.png'")
		(var defenseIcon:str = "OVERMATCHER_ICON_PATH + 'shield_' + palettePrefix + (hasVerdict ? verdict[1] : 'grey') + '.png'")
		# Option "Immer AN": Detailansicht auch ohne Alt (nur mit Bewertung, sonst graue Symbole)
		(var showDetail:bool = "(altVision || isDetailAlways) && hasVerdict")

		# Silhouetten-Namen wie im Spiel-Lebensbalken: shipInfo.ship.shortName
		(var targetVehicleInfo:gfx = "currentTarget && currentTarget.hasComponent(CC.vehicleInfo) ? currentTarget.vehicleInfo : null" (event "evTargetChanged"))
		(var targetShipInfo:gfx = "targetVehicleInfo ? $datahub.getEntity(targetVehicleInfo.shipInfoEntityId) : null" (event "evTargetChanged"))
		(var targetShortName:str = "targetShipInfo ? targetShipInfo.ship.shortName : ''" (event "evTargetChanged"))
		(var targetNameIDS:str = "targetShipInfo ? targetShipInfo.ship.nameIDS : ''" (event "evTargetChanged"))
		(var ownPlayerAvatar:gfx = "$datahub.getSingleEntity(CC.playerAvatar)")
		(var ownAvatarEntity:gfx = "ownPlayerAvatar ? $datahub.getPrimaryEntity(CC.avatar, ownPlayerAvatar.avatar.id) : null")
		(var ownVehicleInfo:gfx = "ownAvatarEntity && ownAvatarEntity.hasComponent(CC.vehicleInfo) ? ownAvatarEntity.vehicleInfo : null" (event "ownAvatarEntity.evAdded"))
		(var ownShipInfoId:number = "ownVehicleInfo ? ownVehicleInfo.shipInfoEntityId : 0" (event "ownVehicleInfo.evShipInfoEntityIdChanged"))
		(var ownShipInfo:gfx = "ownShipInfoId ? $datahub.getEntity(ownShipInfoId) : null")
		(var ownShortName:str = "ownShipInfo ? ownShipInfo.ship.shortName : ''")
		(var ownNameIDS:str = "ownShipInfo ? ownShipInfo.ship.nameIDS : ''")
		(var showSilhouettes:bool = "showDetail && OVERMATCHER_SETTINGS.useSilhouettes && targetShortName != '' && ownShortName != ''")

		# Sektionsfarben: detail = [ich->Ziel Bug, Mitte, Deck, Ziel->ich Bug, Mitte, Deck], 1/0/-1
		# fuer Target und Me gleich: gruen = Overmatch, rot = kein Overmatch, grau = keine Daten.
		(var detail:array = "verdict.length >= 3 && verdict[2].length >= 6 ? verdict[2] : [-1, -1, -1, -1, -1, -1]")
		(var tBow:str = "detail[0] == 1 ? 'green' : (detail[0] == 0 ? 'red' : 'grey')")
		(var tMid:str = "detail[1] == 1 ? 'green' : (detail[1] == 0 ? 'red' : 'grey')")
		(var tDeck:str = "detail[2] == 1 ? 'green' : (detail[2] == 0 ? 'red' : 'grey')")
		(var mBow:str = "detail[3] == 1 ? 'green' : (detail[3] == 0 ? 'red' : 'grey')")
		(var mMid:str = "detail[4] == 1 ? 'green' : (detail[4] == 0 ? 'red' : 'grey')")
		(var mDeck:str = "detail[5] == 1 ? 'green' : (detail[5] == 0 ? 'red' : 'grey')")
		# Mini-Icons der Beschriftung in der Ampelfarbe von Granate bzw. Schild
		(var targetLabel:str = "OVERMATCHER_ICON_PATH + 'label_target_' + palettePrefix + (hasVerdict ? verdict[0] : 'grey') + '.png'")
		(var ownLabel:str = "OVERMATCHER_ICON_PATH + 'label_me_' + palettePrefix + (hasVerdict ? verdict[1] : 'grey') + '.png'")
	)

	(controller $Repeat renderer='OvermatcherTargetTracker'
		(bind count "enemies.items.length" (event "enemies.evAdded") (event "enemies.evRemoved"))
		(exprs
			(scope
				(bind _currentTargetId "currentTarget ? currentTarget.id : 0")
			)
		)
	)

	(block
		(style
			(position = "absolute")
			(bind left "posX")
			(bind top "posY")
			# Option "Groessenskalierung" (um die linke obere Ecke)
			(bind scaleX "uiScale")
			(bind scaleY "uiScale")
		)
		# eigenes Zahnrad links neben der Anzeige, sichtbar bei aktivem Mauszeiger (Strg);
		# oeffnet TTaro Mod Config direkt auf der Overmatcher-Seite (wie BuildViewer)
		(element TT_ConfigButtonElement _modSlug="OVERMATCHER_MOD_SLUG" _tooltipAlign="outerTop|outerLeft"
			(style
				(left = -30px)
				(top = 0px)
			)
		)
		# Greifflaeche zum Verschieben (Mauszeiger im Gefecht z. B. per Strg), wie BuildViewer
		(block
			(class $FullsizeAbsolute)
			(style
				(backgroundColor = 0x00FFFFFF)
				(bind hitTest "!isPositionLocked")
			)
			(macro TT_DRAGGABLE _fullKey="OVERMATCHER_PREF_POSITION" _isDragEnabled="!isPositionLocked")
		)
		(hblock
			(bind visible "!showDetail")
			(element OvermatcherIcon _url="attackIcon")
			(element OvermatcherIcon _url="defenseIcon")
		)
		# absolut an derselben Stelle wie die Symbole, damit nichts springt
		(block
			(bind visible "showDetail && !showSilhouettes")
			(style (position = "absolute") (left = 0) (top = 0))
			# untereinander: oben Target (gehoert zur Granate), unten Me (gehoert zum Schild)
			(element OvermatcherShip _url="attackDetail")
			(element OvermatcherShip _url="defenseDetail")
		)
		# Prototyp: dieselbe Stelle, Spiel-Silhouetten statt gezeichneter Schiffe
		(block
			(bind visible "showSilhouettes")
			(style (position = "absolute") (left = 0) (top = 0))
			(element OvermatcherSilhouetteShip _shortName="targetShortName" _label="targetLabel" _nameIDS="targetNameIDS"
				_bow="tBow" _mid="tMid" _deck="tDeck" _palette="palette")
			(element OvermatcherSilhouetteShip _shortName="ownShortName" _label="ownLabel" _nameIDS="ownNameIDS"
				_bow="mBow" _mid="mMid" _deck="mDeck" _palette="palette")
		)
	)
)

# Detail-Schiff mit eingebauter Beschriftung (Python waehlt das Bild). Gruen = Overmatch:
# Target = Ziel (ich overmatche hier), Me = eigenes Schiff (Gegner overmatcht hier).
# Leeres _url (keine Daten) -> Platz bleibt, damit das andere Schiff nicht verrutscht.
(def element OvermatcherShip(_url:str) layout=true
	(style
		(bind width "OVERMATCHER_SETTINGS.detailWidth")
		(bind height "OVERMATCHER_SETTINGS.detailHeight")
		(bind marginBottom "OVERMATCHER_SETTINGS.shipGap")
	)
	(block
		(bind visible "_url != ''")
		(style
			(bind backgroundImage "_url")
			(bind width "OVERMATCHER_SETTINGS.detailWidth")
			(bind height "OVERMATCHER_SETTINGS.detailHeight")
			(backgroundSize = "fill")
		)
	)
)

# Silhouetten-Ansicht (Prototyp): Beschriftung, Silhouette in vier Sektionen (Deck oben,
# Heck/Mitte/Bug unten), darunter der Schiffsname in der Spielschrift (wie ShipLabel im
# Spiel-Lebensbalken: toUpper(tr(ship.nameIDS))), mittig.
# Die Silhouette wird mehrfach uebereinander gelegt; jede Lage zeigt per Maske nur ihren
# Bereich und wird per colorTransform eingefaerbt (Muster: OwnHealthBarValue im Spiel).
(def element OvermatcherSilhouetteShip(_shortName:str, _label:str, _nameIDS:str, _bow:str, _mid:str, _deck:str, _palette:dict) layout=true
	(scope
		(var s:dict = "OVERMATCHER_SETTINGS")
		(var url:str = "'img://gui/ship_bars/' + _shortName + '_h.png'")
		(var gap:number = "s.zoneGap / 2")
		(var gapY:number = "s.zoneGapY / 2")
	)
	(style
		(bind width "s.silhouetteWidth")
		(bind marginBottom "s.shipGap")
	)
	# Rahmen B3: Band ueber die ganze Hoehe, Haarlinien oben/unten, aufgehellte Kopfzeile mit Trennlinie
	(block
		(class $FullsizeAbsolute)
		(style (backgroundImage = "OVERMATCHER_ICON_PATH + 'frame_band.png'") (backgroundSize = "fill"))
	)
	(block
		(style
			(position = "absolute") (left = 0) (top = 1)
			(bind width "s.silhouetteWidth") (bind height "s.labelHeight - 2")
			(backgroundImage = "OVERMATCHER_ICON_PATH + 'frame_head.png'") (backgroundSize = "fill")
		)
	)
	(block
		(style
			(position = "absolute") (left = 0) (bind top "s.labelHeight - 1")
			(bind width "s.silhouetteWidth") (height = 1)
			(bind alpha "s.headLineAlpha")
			(backgroundImage = "OVERMATCHER_ICON_PATH + 'frame_line.png'") (backgroundSize = "fill")
		)
	)
	(block
		(style
			(position = "absolute") (left = 0) (top = 0)
			(bind width "s.silhouetteWidth") (height = 1)
			(backgroundImage = "OVERMATCHER_ICON_PATH + 'frame_line.png'") (backgroundSize = "fill")
		)
	)
	(block
		(style
			(position = "absolute") (left = 0) (bottom = 0)
			(bind width "s.silhouetteWidth") (height = 1)
			(backgroundImage = "OVERMATCHER_ICON_PATH + 'frame_line.png'") (backgroundSize = "fill")
		)
	)
	(block
		(style
			(bind backgroundImage "_label")
			(bind width "s.labelWidth") (bind height "s.labelHeight")
			(bind marginBottom "-s.labelOverlap")
			(backgroundSize = "fill")
		)
	)
	(block
		(class $OvermatcherSilhouetteFX)
		(style
			(bind width "s.silhouetteWidth")
			(bind height "s.silhouetteHeight")
		)
		(element OvermatcherZone _url="url" _from="0" _to="1" _top="0" _bottom="1" _ct="_palette.base")
		(element OvermatcherZone _url="url" _from="0" _to="1" _top="0" _bottom="s.deckLine - gapY" _ct="_palette[_deck]")
		(element OvermatcherZone _url="url" _from="0" _to="s.sternEnd - gap" _top="s.deckLine + gapY" _bottom="1" _ct="_palette[_bow]")
		(element OvermatcherZone _url="url" _from="s.sternEnd + gap" _to="s.bowStart - gap" _top="s.deckLine + gapY" _bottom="1" _ct="_palette[_mid]")
		(element OvermatcherZone _url="url" _from="s.bowStart + gap" _to="1" _top="s.deckLine + gapY" _bottom="1" _ct="_palette[_bow]")
	)
	(block
		(bind visible "_nameIDS != ''")
		(style
			(bind width "s.silhouetteWidth")
			(bind marginTop "s.nameGap")
			(bind marginBottom "s.nameBottom")
			(align = "center")
		)
		(tf
			(class $TextDefaultBold13NM)
			(class $FontEnableReadability)
			(bind text "toUpper(tr(_nameIDS))")
		)
	)
)

# Eine Lage der Silhouette: zentriert wie im Spiel-Lebensbalken, Maske x _from.._to, y _top.._bottom
# (Anteile der Bildbreite bzw. -hoehe).
(def element OvermatcherZone(_url:str, _from:number, _to:number, _top:number, _bottom:number, _ct:dict) layout=true
	(style
		(position = "absolute")
		(left = 50%)
		(marginLeft = -50%)
		(backgroundSize = "autosize")
		(bind backgroundImage "_url")
	)
	(block
		(style
			(position = "absolute")
			(bind top "100% * _top")
			(bind height "100% * (_bottom - _top)")
			(bind left "100% * _from")
			(bind width "100% * (_to - _from)")
			(backgroundColor = 0x11000000)
		)
		(isMask = true)
	)
	(bind colorTransform "_ct")
)

(def element OvermatcherIcon(_url:str) layout=true
	(style
		(bind backgroundImage "_url")
		(bind width "OVERMATCHER_SETTINGS.iconSize") (bind height "OVERMATCHER_SETTINGS.iconSize")
		(backgroundSize = "fill")
		(bind marginRight "OVERMATCHER_SETTINGS.iconGap")
	)
)

# Kopie von XTargetTracker unter eigenem Namen (ModForge meldet doppelte Namen als Konflikt)
(def element OvermatcherTargetTracker() layout=false
	(scope
		(var _currentTargetId:number = 0)
		(var avatars:gfx = "$datahub.getCollection(CC.avatar)")
		(var trackedEntity:gfx = "avatars.items[$index]" watch=false)
		(var targetComponent:gfx = "trackedEntity.hasComponent(CC.target) ? trackedEntity.target : null"
			(event "trackedEntity.evAdded")
			(event "trackedEntity.evRemoved")
		)
		(var targetFlags:number = "targetComponent ? targetComponent.flags : 0"
			(event "targetComponent.evFlagsChanged")
		)
		(var isTargetLocked:bool = "(targetFlags & LOCKABLE_WEAPONS) > 0")
	)
	(dispatch evTargetChanged args="{entity: isTargetLocked ? trackedEntity : null}" dir="EventDirection.UP"
		(bind enabled "isTargetLocked || _currentTargetId == trackedEntity.id")
		(event "targetComponent.evFlagsChanged")
	)
	(dispatch evTargetChanged args="{entity: trackedEntity}" dir="EventDirection.UP" on='addedToStage'
		(bind enabled "isTargetLocked")
	)
)
